# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/fraudos
# Must be >= 32 chars — the PII vault encryption key is derived from it.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FRAUDOS_TOKEN_SECRET=
ANTHROPIC_API_KEY=sk-ant-...

# ── Environment ───────────────────────────────────────────────────────────────
# Defaults to production (fail-safe). Set to development ONLY for local work —
# development mode disables secret validation and seeds a default admin login.
FRAUDOS_ENV=production

# Required in production before first startup (seeds the admin account)
FRAUDOS_ADMIN_PASSWORD=

# Required for webhook ingestion (endpoint rejects everything if unset)
FRAUDOS_WEBHOOK_SECRET=

# Comma-separated origins for a separately hosted frontend (not needed when
# the backend serves frontend/dist same-origin)
# ALLOWED_ORIGINS=https://fraudos.example.com

# ── Notifications (all optional) ──────────────────────────────────────────────
FRAUDOS_SMTP_HOST=
FRAUDOS_SMTP_USER=
FRAUDOS_SMTP_PASSWORD=
FRAUDOS_SMTP_PORT=587
FRAUDOS_ALERT_EMAIL_TO=
FRAUDOS_SLACK_WEBHOOK_URL=
