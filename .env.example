# Required
DATABASE_URL=postgresql://user:password@host:5432/fraudos
FRAUDOS_TOKEN_SECRET=change-me-to-a-long-random-string
ANTHROPIC_API_KEY=sk-ant-...

# Optional but recommended in production
FRAUDOS_API_KEY=change-me
FRAUDOS_ADMIN_PASSWORD=change-me
FRAUDOS_ENV=production

# Notifications (all optional)
FRAUDOS_SMTP_HOST=
FRAUDOS_SMTP_USER=
FRAUDOS_SMTP_PASSWORD=
FRAUDOS_SMTP_PORT=587
FRAUDOS_ALERT_EMAIL_TO=
FRAUDOS_SLACK_WEBHOOK_URL=
